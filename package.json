{
  "name": "unified-inbox",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build:gui": "bun run --cwd packages/gui build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test packages/shared packages/relay packages/gui packages/provision && bun run --cwd packages/connector-hub test",
    "seed": "bun run --cwd packages/seed seed",
    "manual:screenshots": "bun run scripts/manual-screenshots.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright": "^1.64.1",
    "typescript": "^5.9.0"
  }
}