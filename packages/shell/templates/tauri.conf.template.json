{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inbox",
  "version": "0.1.0",
  "identifier": "com.unified-inbox.shell",
  "build": {
    "devUrl": "__INBOX_RELAY_URL__",
    "frontendDist": "__INBOX_RELAY_URL__"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Inbox",
        "url": "__INBOX_RELAY_URL__",
        "width": 1280,
        "height": 800,
        "minWidth": 402,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "Unified Inbox",
    "longDescription": "One inbox for iMessage, Slack, and WhatsApp. The shell loads the GUI from your relay and opens replies in the native apps.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "hardenedRuntime": true
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
